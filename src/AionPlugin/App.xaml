<Application x:Class="AionPlugin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:AionPlugin.Helpers"
             StartupUri="Views/MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">

    <Application.Resources>
        <!-- 컨버터 전역 등록 -->
        <helpers:PercentToWidthConverter  x:Key="PercentToWidthConverter"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <helpers:NullToVisibilityConverter x:Key="NullToHidConverter" Invert="True"/>
        <helpers:ListIndexConverter        x:Key="IndexConverter"/>
    </Application.Resources>
</Application>
