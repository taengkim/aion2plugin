<Window x:Class="AionPlugin.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AionPlugin.Views"
        Title="AionPlugin Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Width="380"
        Height="420"
        Left="20"
        Top="20">

    <Window.Resources>
        <!-- 배경 브러시 -->
        <SolidColorBrush x:Key="PanelBg" Color="#CC0D0D12"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#DD151520"/>
        <SolidColorBrush x:Key="RowBg" Color="#88080810"/>
        <SolidColorBrush x:Key="RowAltBg" Color="#440D0D1A"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#FF4A9EFF"/>
        <SolidColorBrush x:Key="AccentGold" Color="#FFFFD700"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFEAEAEA"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF8A8AA0"/>
        <SolidColorBrush x:Key="BorderColor" Color="#44FFFFFF"/>

        <!-- 타이틀 폰트 -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- 헤더 컬럼 -->
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 데이터 텍스트 -->
        <Style x:Key="DataText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- 전체 패널: 드래그 가능 -->
    <Border Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="6"
            MouseLeftButtonDown="OnDragMove">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>   <!-- 타이틀 바 -->
                <RowDefinition Height="22"/>   <!-- 전투 상태 바 -->
                <RowDefinition Height="22"/>   <!-- 컬럼 헤더 -->
                <RowDefinition Height="*"/>    <!-- 플레이어 목록 -->
                <RowDefinition Height="28"/>   <!-- 하단 버튼 -->
            </Grid.RowDefinitions>

            <!-- ── 타이틀 바 ── -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBg}" CornerRadius="6,6,0,0">
                <Grid Margin="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚔" Foreground="{StaticResource AccentGold}" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Style="{StaticResource TitleText}" Text="AION2 PLUGIN" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource TitleText}" Text=" - DPS &amp; ATUUL"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 우측 버튼 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnLock" Content="🔓" Width="22" Height="22"
                                Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                BorderThickness="0" FontSize="11" ToolTip="드래그 잠금"
                                Click="OnToggleLock" Cursor="Hand"/>
                        <Button Content="×" Width="22" Height="22" Margin="4,0,0,0"
                                Background="Transparent" Foreground="#FFFF6060"
                                BorderThickness="0" FontSize="14"
                                Click="OnClose" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── 전투 상태 바 ── -->
            <Border Grid.Row="1" Background="#44FF8C00" Margin="1,0">
                <Grid Margin="10,0">
                    <TextBlock x:Name="TxtStatus" Style="{StaticResource TitleText}"
                               Text="● 대기 중" Foreground="#FF8A8AA0"
                               VerticalAlignment="Center" FontSize="10"/>
                    <TextBlock x:Name="TxtTimer" Style="{StaticResource DataText}"
                               Text="00:00" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="10"
                               Foreground="{StaticResource TextSecondary}"/>
                </Grid>
            </Border>

            <!-- ── 컬럼 헤더 ── -->
            <Grid Grid.Row="2" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>   <!-- 순위 -->
                    <ColumnDefinition Width="*"/>    <!-- 이름 -->
                    <ColumnDefinition Width="70"/>   <!-- 총 딜 -->
                    <ColumnDefinition Width="60"/>   <!-- DPS -->
                    <ColumnDefinition Width="34"/>   <!-- % -->
                    <ColumnDefinition Width="44"/>   <!-- 아툴 -->
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource ColHeader}" Text="#"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ColHeader}" Text="이름"/>
                <TextBlock Grid.Column="2" Style="{StaticResource ColHeader}" Text="총 딜" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Style="{StaticResource ColHeader}" Text="DPS" TextAlignment="Right"/>
                <TextBlock Grid.Column="4" Style="{StaticResource ColHeader}" Text="%" TextAlignment="Right"/>
                <TextBlock Grid.Column="5" Style="{StaticResource ColHeader}" Text="아툴" TextAlignment="Right"/>
            </Grid>

            <!-- ── 플레이어 목록 ── -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PlayerList" ItemsSource="{Binding SortedPlayers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="RowGrid" Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>  <!-- 순위 + 바 -->
                                    <ColumnDefinition Width="16"/>  <!-- 직업 아이콘 -->
                                    <ColumnDefinition Width="*"/>   <!-- 이름 -->
                                    <ColumnDefinition Width="70"/>  <!-- 총 딜 -->
                                    <ColumnDefinition Width="60"/>  <!-- DPS -->
                                    <ColumnDefinition Width="34"/>  <!-- % -->
                                    <ColumnDefinition Width="44"/>  <!-- 아툴 -->
                                </Grid.ColumnDefinitions>

                                <!-- 딜 비율 배경 바 -->
                                <Border Grid.ColumnSpan="7" VerticalAlignment="Stretch"
                                        HorizontalAlignment="Left"
                                        Height="20" CornerRadius="2"
                                        Opacity="0.25">
                                    <Border.Width>
                                        <Binding Path="DamagePercent"
                                                 Converter="{StaticResource PercentToWidthConverter}"
                                                 ConverterParameter="372"/>
                                    </Border.Width>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF4A9EFF" Offset="0"/>
                                            <GradientStop Color="#FF8A4AFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- 순위 -->
                                <TextBlock Grid.Column="0" Margin="8,0,0,0"
                                           Style="{StaticResource DataText}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="10"
                                           Text="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                          Path=DataContext,
                                                          Converter={StaticResource IndexConverter},
                                                          ConverterParameter={Binding}}"/>

                                <!-- 직업 아이콘 -->
                                <TextBlock Grid.Column="1" Style="{StaticResource DataText}"
                                           Text="{Binding ClassIcon}" FontSize="11"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <!-- 이름 -->
                                <TextBlock Grid.Column="2" Style="{StaticResource DataText}"
                                           Text="{Binding Name}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="2,0,4,0"/>

                                <!-- 총 딜 -->
                                <TextBlock Grid.Column="3" Style="{StaticResource DataText}"
                                           Text="{Binding TotalDamageDisplay}"
                                           TextAlignment="Right" FontSize="10"
                                           Foreground="{StaticResource AccentBlue}"/>

                                <!-- DPS -->
                                <TextBlock Grid.Column="4" Style="{StaticResource DataText}"
                                           Text="{Binding DpsDisplay}"
                                           TextAlignment="Right" FontSize="10" Margin="2,0"/>

                                <!-- 딜 비율 -->
                                <TextBlock Grid.Column="5" Style="{StaticResource DataText}"
                                           Text="{Binding DamagePercentDisplay}"
                                           TextAlignment="Right" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"/>

                                <!-- 아툴 점수 -->
                                <Grid Grid.Column="6" Margin="2,0,8,0">
                                    <!-- 로딩 중 -->
                                    <TextBlock Text="..." FontSize="9"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsLoadingAtuul,
                                                            Converter={StaticResource BoolToVisConverter}}"/>
                                    <!-- 점수 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding AtuulScore,
                                                             Converter={StaticResource NullToVisConverter}}">
                                        <TextBlock Text="{Binding AtuulScore.GradeDisplay}"
                                                   Foreground="{Binding AtuulScore.GradeColor}"
                                                   FontSize="10" FontWeight="Bold"/>
                                        <TextBlock Text=" " FontSize="10"/>
                                        <TextBlock Text="{Binding AtuulScore.ScoreDisplay}"
                                                   Foreground="{StaticResource AccentGold}"
                                                   FontSize="10"/>
                                    </StackPanel>
                                    <!-- 점수 없음 -->
                                    <TextBlock Text="-" FontSize="9"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding AtuulScore,
                                                            Converter={StaticResource NullToHidConverter}}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── 하단 버튼 바 ── -->
            <Border Grid.Row="4" Background="{StaticResource HeaderBg}" CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Button Content="초기화" Width="50" Height="20" FontSize="9"
                            Background="#33FFFFFF" Foreground="{StaticResource TextPrimary}"
                            BorderThickness="1" BorderBrush="{StaticResource BorderColor}"
                            Click="OnReset" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="설정" Width="40" Height="20" FontSize="9"
                            Background="#33FFFFFF" Foreground="{StaticResource TextPrimary}"
                            BorderThickness="1" BorderBrush="{StaticResource BorderColor}"
                            Click="OnSettings" Cursor="Hand"/>
                    <TextBlock x:Name="TxtPartyTotal"
                               Style="{StaticResource DataText}"
                               FontSize="9" Margin="12,0,0,0"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
