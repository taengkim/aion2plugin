<Window x:Class="AionPlugin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AionPlugin - 설정"
        Width="480" Height="560"
        MinWidth="400" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FF0D0D12">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPanel"      Color="#FF151520"/>
        <SolidColorBrush x:Key="AccentBlue"   Color="#FF4A9EFF"/>
        <SolidColorBrush x:Key="AccentGold"   Color="#FFFFD700"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#FFEAEAEA"/>
        <SolidColorBrush x:Key="TextSecond"   Color="#FF8A8AA0"/>
        <SolidColorBrush x:Key="BorderCol"    Color="#44FFFFFF"/>
        <SolidColorBrush x:Key="InputBg"      Color="#FF0A0A14"/>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecond}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 타이틀 -->
            <RowDefinition Height="Auto"/>   <!-- 상태 -->
            <RowDefinition Height="*"/>      <!-- 설정 탭 -->
            <RowDefinition Height="Auto"/>   <!-- 하단 버튼 -->
        </Grid.RowDefinitions>

        <!-- 타이틀 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="⚔" Foreground="{StaticResource AccentGold}" FontSize="22" Margin="0,0,8,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="AION2 PLUGIN" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource AccentBlue}" FontFamily="Segoe UI"/>
                <TextBlock Text="파티 DPS + 아툴 점수 오버레이" FontSize="10"
                           Foreground="{StaticResource TextSecond}" FontFamily="Segoe UI"/>
            </StackPanel>
        </StackPanel>

        <!-- 실시간 상태 -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderCol}" BorderThickness="1"
                CornerRadius="4" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtMainStatus" Text="대기 중"
                               Foreground="{StaticResource TextSecond}"
                               FontSize="11" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="TxtError" Text=""
                               Foreground="#FFFF6060" FontSize="10"
                               FontFamily="Segoe UI" Visibility="Collapsed"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnStartStop"
                        Content="시작" Width="70" Height="28"
                        Background="#FF1A3A6A" BorderBrush="{StaticResource AccentBlue}"
                        Foreground="{StaticResource AccentBlue}" FontWeight="Bold"
                        Click="OnStartStop"/>
            </Grid>
        </Border>

        <!-- 설정 탭 -->
        <TabControl Grid.Row="2" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderCol}">

            <!-- ── 네트워크 설정 ── -->
            <TabItem Header="네트워크" Foreground="{StaticResource TextPrimary}">
                <StackPanel Margin="12" VerticalAlignment="Top">

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="네트워크 어댑터"/>
                        <ComboBox Grid.Column="1" x:Name="CmbDevice"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="게임 서버 IP"/>
                        <TextBox Grid.Column="1" x:Name="TxtServerIp"
                                 Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="비워두면 포트 기반으로만 필터링합니다"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="서버명 (아툴용)"/>
                        <TextBox Grid.Column="1" x:Name="TxtServerName"
                                 Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="aion2tools.com 에서 사용할 서버명 (예: Israphel)"/>
                    </Grid>

                    <TextBlock Text="※ Npcap 드라이버가 필요합니다. npcap.com 에서 설치하세요."
                               Foreground="{StaticResource TextSecond}" FontSize="10"
                               FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- ── 오버레이 설정 ── -->
            <TabItem Header="오버레이" Foreground="{StaticResource TextPrimary}">
                <StackPanel Margin="12" VerticalAlignment="Top">

                    <CheckBox x:Name="ChkAlwaysTop" Content="항상 위 (Always on Top)"
                              IsChecked="True" Margin="0,0,0,10"
                              Checked="OnAlwaysTopChanged" Unchecked="OnAlwaysTopChanged"/>

                    <CheckBox x:Name="ChkShowAtuul" Content="아툴 점수 표시"
                              IsChecked="True" Margin="0,0,0,10"
                              Checked="OnShowAtuulChanged" Unchecked="OnShowAtuulChanged"/>

                    <CheckBox x:Name="ChkClickThrough" Content="클릭 투과 (게임 클릭 방해 없음)"
                              IsChecked="False" Margin="0,0,0,10"
                              Checked="OnClickThroughChanged" Unchecked="OnClickThroughChanged"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="투명도"/>
                        <Slider Grid.Column="1" x:Name="SldOpacity"
                                Minimum="0.3" Maximum="1.0" Value="0.9"
                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                ValueChanged="OnOpacityChanged"/>
                    </Grid>

                    <Button Content="오버레이 표시" HorizontalAlignment="Left"
                            Click="OnShowOverlay"/>
                </StackPanel>
            </TabItem>

            <!-- ── 로그 ── -->
            <TabItem Header="로그" Foreground="{StaticResource TextPrimary}">
                <Grid Margin="8">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="#FF050508" Foreground="#FF80FF80"
                             FontFamily="Consolas" FontSize="10"
                             MaxLines="500"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 하단 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="v1.0.0  " Foreground="{StaticResource TextSecond}"
                       FontSize="10" VerticalAlignment="Center"/>
            <Button Content="오버레이 열기" Click="OnShowOverlay" Margin="0,0,8,0"/>
            <Button Content="닫기" Click="OnHide"/>
        </StackPanel>
    </Grid>
</Window>
